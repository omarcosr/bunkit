{
  // Base tsconfig for apps using @omarcosr/bunkit's JSX runtime.
  //
  //   {
  //     "extends": "@omarcosr/bunkit/tsconfig",
  //     "include": ["src"]
  //   }
  //
  // Without jsxImportSource: "@omarcosr/bunkit", the editor resolves JSX through
  // React's runtime, which types every element as ReactElement — so
  // `const log = <TextArea …/>` loses its control type.
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "ESNext"
    ],
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@omarcosr/bunkit",
    "strict": true,
    "skipLibCheck": false
  }
}