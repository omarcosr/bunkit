{
  "name": "@omarcosr/bunkit",
  "version": "0.1.1",
  "description": "Native desktop applications for Bun on macOS and Windows. No WebView.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*"
  ],
  "homepage": "https://github.com/omarcosr/bunkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omarcosr/bunkit.git"
  },
  "bugs": {
    "url": "https://github.com/omarcosr/bunkit/issues"
  },
  "keywords": [
    "macos",
    "appkit",
    "objective-c",
    "bun",
    "ffi",
    "libffi",
    "native",
    "gui",
    "desktop",
    "cocoa",
    "windows",
    "winui",
    "typescript"
  ],
  "os": [
    "darwin",
    "win32"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "types": "./src/index.ts",
  "files": [
    "src",
    "tsconfig.base.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "optionalDependencies": {
    "@omarcosr/bunkit-darwin-arm64": "workspace:*",
    "@omarcosr/bunkit-win32-x64": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./objc": "./src/objc.ts",
    "./bridge": "./src/bridge.ts",
    "./constants": "./src/generated/constants.ts",
    "./runtime": "./src/runtime.ts",
    "./structs": "./src/structs.ts",
    "./types": "./src/generated/appkit.d.ts",
    "./metal": "./src/metal/index.ts",
    "./jsx-runtime": "./src/jsx-runtime.tsx",
    "./tsconfig": "./tsconfig.base.json"
  },
  "scripts": {
    "build": "./native/build.sh",
    "build:windows": "powershell -ExecutionPolicy Bypass -File native/windows/build.ps1",
    "hello": "bun run examples/hello.ts",
    "tour": "bun run examples/tour.ts",
    "demo": "bun run examples/demo.ts",
    "gallery": "bun run examples/gallery.ts",
    "tsx-gallery": "bun run examples/gallery.tsx",
    "counter": "bun run examples/counter.ts",
    "counter-tsx": "bun run examples/counter.tsx",
    "todo": "bun run examples/todo.tsx",
    "scene": "bun run examples/scene3d.ts",
    "rig": "bun run examples/lighting-rig.ts",
    "playground": "bun run examples/shader-playground.ts",
    "particles": "bun run examples/particles.ts",
    "test": "bun run test/all.ts",
    "typecheck": "tsc -p .",
    "check:package": "bun run tools/check-package.ts",
    "check:native": "bun run tools/check-native.ts",
    "stage:binaries": "bun run tools/stage-binaries.ts",
    "verify:release": "bun run tools/check-package.ts --require-binaries",
    "prepublishOnly": "bun run verify:release",
    "gen": "bun run tools/gen-constants.ts && bun run tools/gen-types.ts",
    "gen:constants": "bun run tools/gen-constants.ts",
    "gen:types": "bun run tools/gen-types.ts",
    "bundle": "bun run tools/bundle.ts",
    "bundle:windows": "powershell -ExecutionPolicy Bypass -File native/windows/bundle.ps1",
    "package:windows": "powershell -ExecutionPolicy Bypass -File native/windows/package.ps1",
    "installer:windows": "powershell -ExecutionPolicy Bypass -File native/windows/installer.ps1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
