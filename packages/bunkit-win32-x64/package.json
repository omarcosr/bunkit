{
  "name": "@omarcos/bunkit-win32-x64",
  "version": "0.1.0",
  "description": "Native Windows x64 bridge for @omarcos/bunkit.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omarcosr/bunkit.git"
  },
  "os": ["win32"],
  "cpu": ["x64"],
  "files": [
    "bin/winbridge.dll",
    "bin/Microsoft.WindowsAppRuntime.Bootstrap.dll",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    "./winbridge.dll": "./bin/winbridge.dll",
    "./Microsoft.WindowsAppRuntime.Bootstrap.dll": "./bin/Microsoft.WindowsAppRuntime.Bootstrap.dll",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "bun run ../../tools/check-package.ts --package @omarcos/bunkit-win32-x64 --require-binaries"
  }
}